# Supabase (Fase 2: formulário de contato · Fase 3+: auth, planos, assinaturas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — ignora RLS, só para o webhook do Stripe. Nunca expor ao client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Fase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_IMPULSO=
NEXT_PUBLIC_STRIPE_PRICE_MENTORIA=

# Grupo de WhatsApp do plano Grátis (Fase 3)
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=

# IA (Fase 4) — currículo, análise de LinkedIn, simulação de entrevista.
# Chamada SEMPRE no backend via src/lib/ai/client.ts, nunca no client.
# Provedor atual: OpenAI, chave paga. Sensível: nunca expor no client, nunca
# commitar — ver HANDOFF.md para o histórico completo.
OPENAI_API_KEY=

# Cal.com (Fase 4b) — agendamento da sessão mensal do plano Mentoria.
# CALCOM_API_KEY é sensível: nunca expor no client, nunca commitar.
CALCOM_API_KEY=
NEXT_PUBLIC_CALCOM_LINK=
# Gerado por nós (não vem do Cal.com), enviado na criação do webhook — ver
# src/app/api/webhooks/calcom/route.ts.
CALCOM_WEBHOOK_SECRET=

# Resend (Fase 3+) — convite pro grupo de WhatsApp no primeiro currículo
# gerado. RESEND_FROM_EMAIL é opcional: sem domínio verificado no Resend, o
# padrão "Ryze <onboarding@resend.dev>" só entrega pro e-mail dono da conta
# Resend, não pra candidatos reais — configure só depois de verificar um
# domínio próprio.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
